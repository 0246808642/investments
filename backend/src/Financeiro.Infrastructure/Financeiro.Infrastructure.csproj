         mapeamento sao os mesmos constantes; sem isto teriam que redigitar os
         nomes e a divergencia voltaria pela porta dos fundos. -->
    <InternalsVisibleTo Include="Financeiro.Infrastructure.Tests" />
  </ItemGroup>

