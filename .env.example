# Copie para .env.local (ignorado pelo git) apenas se precisar.
#
# Em condicao normal NAO e preciso configurar nada: o frontend e a API sao dois
# servicos do mesmo projeto na Vercel, atras do mesmo dominio, e em
# desenvolvimento o proxy do Vite leva /api ate o backend local.
#
# Esta variavel existe como escape: apontar um build local contra uma API ja
# publicada, ou contra um backend que nao esteja na porta padrao.
#
# VITE_API_URL=https://investments.vercel.app
